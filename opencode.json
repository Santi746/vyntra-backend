{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "rules.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "skill": {
      "laravel-scalability": "allow",
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "Test-Path*": "allow",
      "Select-String*": "allow",
      "Test-Json*": "allow",
      "php artisan list": "allow",
      "php artisan about": "allow",
      "php artisan route:list*": "allow",
      "php artisan config:show*": "allow",
      "php artisan db:show*": "allow",
      "php artisan db:table*": "allow",
      "php artisan model:show*": "allow",
      "composer show*": "allow",
      "composer outdated*": "allow",
      "composer validate*": "allow"
    }
  }
}
