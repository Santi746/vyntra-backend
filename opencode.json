{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["rules.md", "docs/architecture/mandatory_patterns.md", "AGENTS.md", "docs/architecture/hitl_protocol.md", "PIN.md"],
  "agent": {
    "asistente-ejecutor": {
      "description": "Asistente Ejecutor: Planifica, implementa y depura código con el usuario. Siempre crea un plan.md antes de ejecutar."
    }
  },
   "mcp": {
    "hitl-proxy": {
      "type": "local",
      "command": ["node", "./hitl-proxy/src/index.js"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "write": "deny",
    "webfetch": "ask",
    "skill": {
      "laravel-scalability": "allow",
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "Test-Path*": "allow",
      "Select-String*": "allow",
      "Test-Json*": "allow",
      "php artisan list": "allow",
      "php artisan about": "allow",
      "php artisan route:list*": "allow",
      "php artisan config:show*": "allow",
      "php artisan db:show*": "allow",
      "php artisan db:table*": "allow",
      "php artisan model:show*": "allow",
      "composer show*": "allow",
      "composer outdated*": "allow",
      "composer validate*": "allow"
    }
  }
}
